# Copy to .env.local — never commit real values
# Vercel KV names (or Upstash marketplace names — both work):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional shared secret the Obsidian client sends as x-obsidian-secret.
# If set, verify/create require it. Set the same value in Vercel env vars.
# OBSIDIAN_API_SECRET=

# Master keys (comma-separated). Skip KV/HWID/expiry. Vercel dashboard ONLY.
# ADMIN_KEYS=

# Linkvertise anti-bypass auth token (dashboard Settings -> Anti-Bypassing).
# When set, linkvertise keys require a confirmed ?hash= completion.
# LINKVERTISE_TOKEN=
